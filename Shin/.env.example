# Copy this file to .env and fill in your API keys if desired.
# Shin works fully offline without any keys — keys only enable smarter conversational NLP.

# ── Optional AI back-ends (fill in ONE, BOTH, or use Local AI) ───────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Discovered Multi-Provider Cloud APIs & Free AI Credentials ───────────────
# Groq Ultra-Fast Inference API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# ── Local AI via LM Studio (privacy-first, no cloud needed) ───────────────────
# Run LM Studio (https://lmstudio.ai), load your model, and start the local server on port 1234.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# ── Local AI via Ollama (privacy-first, no cloud needed) ──────────────────────
# Install Ollama: https://ollama.com  then: ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
WEATHER_CITY=Mumbai
WORLD_NEWS_API_KEY=

# ── Speech Recognition back-end ───────────────────────────────────────────────
# "google"  → online, free, accurate, requires internet (default)
# "vosk"    → fully offline, uses built-in Vosk models in ./languages/
ASR_BACKEND=google
ASR_LANGUAGE=en-IN

# ── Vosk offline model path (only needed if ASR_BACKEND=vosk) ─────────────────
VOSK_MODEL_PATH=./languages/vosk-model-small-en-us-0.15

# ── TTS back-end ─────────────────────────────────────────────────────────────
# "edge"      → Microsoft Edge online neural voice (natural Hinglish with en-IN-NeerjaNeural, free, default)
# "pyttsx3"   → Windows SAPI offline voice (offline fallback)
# "kokoro"    → fully offline neural voice (Kokoro 82M)
# "lm_studio" → LM Studio Voice Studio TTS
TTS_BACKEND=edge
TTS_SPEED=1.0
EDGE_TTS_VOICE=hi-IN-SwaraNeural
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_PITCH=+0Hz

# ── Wake Word & Noise Reduction ───────────────────────────────────────────────
WAKE_WORD=hey shin
WAKE_WORD_ENABLED=false
USE_NOISE_REDUCTION=true

# ── Voice Biometrics (Set to false for friends so it responds to their voice) ──
VOICE_AUTH_ENABLED=false
VOICE_AUTH_THRESHOLD=0.75

# ── 3D Desktop Mascot (Mate Engine) ───────────────────────────────────────────
# Set to "true" to disable the 3D mascot and run as a lightweight background assistant
DISABLE_MASCOT=false
MATE_ENGINE_ENABLED=true
